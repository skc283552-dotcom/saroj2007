<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Saroj Personal Accounting</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400&family=Cormorant+Garamond:wght@300;400;500;600&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.6.0/jspdf.plugin.autotable.min.js"></script>
<style>
:root{
  --gold:#C9A84C;--gold2:#E8C96A;--gold3:#F5E6A3;--gold-dim:#7A6030;
  --gold-bg:rgba(201,168,76,0.07);--gold-border:rgba(201,168,76,0.25);
  --black:#080808;--dark:#0F0F0F;--dark2:#161616;--dark3:#1E1E1E;--dark4:#262626;--dark5:#2E2E2E;
  --text:#EDE0C4;--text2:#C4AA78;--text3:#7A6A48;
  --red:#C0392B;--red2:#E74C3C;--green:#1E8449;--green2:#27AE60;--blue:#1A6B9A;--blue2:#2980B9;
  --shadow:0 8px 40px rgba(0,0,0,0.8);--shadow2:0 2px 12px rgba(0,0,0,0.5);
  --radius:8px;--radius2:14px;--trans:all 0.25s cubic-bezier(0.4,0,0.2,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html{scroll-behavior:smooth;}
body{background:var(--black);color:var(--text);font-family:'Cormorant Garamond',serif;min-height:100vh;overflow-x:hidden;}
::-webkit-scrollbar{width:5px;height:5px;}::-webkit-scrollbar-track{background:var(--dark2);}::-webkit-scrollbar-thumb{background:var(--gold-dim);border-radius:4px;}
.hidden{display:none!important;}
.page{display:none;min-height:100vh;flex-direction:column;}
.page.active{display:flex;}
.bg-grid{position:fixed;inset:0;pointer-events:none;z-index:0;background-image:linear-gradient(rgba(201,168,76,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(201,168,76,0.03) 1px,transparent 1px);background-size:40px 40px;}
.bg-glow{position:fixed;pointer-events:none;z-index:0;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(201,168,76,0.04) 0%,transparent 70%);}
.bg-glow.tr{top:-200px;right:-200px;}.bg-glow.bl{bottom:-200px;left:-200px;}
#toast-wrap{position:fixed;top:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:10px;}
.toast{padding:12px 20px;border-radius:var(--radius);font-family:'JetBrains Mono',monospace;font-size:13px;border-left:3px solid var(--gold);background:var(--dark3);color:var(--text);box-shadow:var(--shadow);animation:sIn .3s ease,fOut .4s ease 3s forwards;max-width:320px;}
.toast.success{border-color:var(--green2);}.toast.error{border-color:var(--red2);}
@keyframes sIn{from{transform:translateX(120%);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes fOut{to{opacity:0;transform:translateX(120%)}}
.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 22px;border-radius:var(--radius);border:1px solid var(--gold-border);background:var(--gold-bg);color:var(--gold2);font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:500;cursor:pointer;transition:var(--trans);white-space:nowrap;}
.btn:hover{background:var(--gold);color:var(--black);border-color:var(--gold);transform:translateY(-1px);box-shadow:0 4px 20px rgba(201,168,76,0.3);}
.btn.primary{background:var(--gold);color:var(--black);border-color:var(--gold);font-weight:700;}
.btn.primary:hover{background:var(--gold2);box-shadow:0 6px 24px rgba(201,168,76,0.5);}
.btn.danger{border-color:rgba(192,57,43,0.4);color:var(--red2);background:rgba(192,57,43,0.07);}
.btn.danger:hover{background:var(--red2);color:#fff;}
.btn.sm{padding:6px 14px;font-size:14px;}.btn.icon{padding:8px;border-radius:50%;width:36px;height:36px;justify-content:center;}
.form-group{display:flex;flex-direction:column;gap:6px;}
.form-group label{font-size:12px;color:var(--text2);font-family:'JetBrains Mono',monospace;letter-spacing:.06em;text-transform:uppercase;}
.form-control{background:var(--dark3);border:1px solid var(--gold-border);color:var(--text);padding:10px 14px;border-radius:var(--radius);font-family:'Cormorant Garamond',serif;font-size:16px;transition:var(--trans);width:100%;}
.form-control:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,168,76,0.12);}
.form-control option{background:var(--dark3);}
.fg{display:grid;gap:16px;}.fg.c2{grid-template-columns:1fr 1fr;}.fg.c3{grid-template-columns:1fr 1fr 1fr;}
@media(max-width:600px){.fg.c2,.fg.c3{grid-template-columns:1fr;}}
.card{background:var(--dark2);border:1px solid var(--gold-border);border-radius:var(--radius2);padding:24px;box-shadow:var(--shadow2);}
.card-title{font-family:'Playfair Display',serif;font-size:20px;color:var(--gold2);margin-bottom:18px;display:flex;align-items:center;gap:10px;}
.table-wrap{overflow-x:auto;border-radius:var(--radius);}
table{width:100%;border-collapse:collapse;font-size:15px;}
thead tr{background:var(--dark4);}
thead th{padding:12px 14px;text-align:left;color:var(--gold);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;border-bottom:1px solid var(--gold-border);white-space:nowrap;}
tbody tr{border-bottom:1px solid rgba(201,168,76,0.07);transition:var(--trans);}
tbody tr:hover{background:var(--gold-bg);}
tbody td{padding:11px 14px;color:var(--text);}
tfoot tr{background:var(--dark4);}
tfoot td{padding:12px 14px;color:var(--gold2);font-weight:600;border-top:2px solid var(--gold-border);font-family:'JetBrains Mono',monospace;}
.top-nav{position:sticky;top:0;z-index:100;background:rgba(8,8,8,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--gold-border);padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;}
.nav-brand{font-family:'Playfair Display',serif;font-size:19px;color:var(--gold);letter-spacing:.04em;display:flex;align-items:center;gap:12px;}
.nav-logo{width:34px;height:34px;border-radius:50%;object-fit:cover;border:2px solid var(--gold-dim);}
.nav-logo-ph{width:34px;height:34px;border-radius:50%;background:var(--gold-bg);border:2px solid var(--gold-dim);display:flex;align-items:center;justify-content:center;font-size:16px;}
.nav-right{display:flex;align-items:center;gap:14px;}
.nav-clock .time{font-family:'JetBrains Mono',monospace;font-size:17px;color:var(--gold);}
.nav-clock .dt{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text3);}
.back-btn{display:inline-flex;align-items:center;gap:6px;color:var(--text2);font-size:14px;cursor:pointer;padding:6px 12px;border-radius:var(--radius);border:1px solid transparent;transition:var(--trans);font-family:'JetBrains Mono',monospace;background:none;}
.back-btn:hover{color:var(--gold);border-color:var(--gold-border);background:var(--gold-bg);}
.ph{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px;}
.ptitle{font-family:'Playfair Display',serif;font-size:28px;color:var(--gold2);}
.psub{font-size:15px;color:var(--text3);margin-top:3px;}
.cw{padding:28px 24px;flex:1;position:relative;z-index:1;max-width:1400px;margin:0 auto;width:100%;}
.sec-title{font-family:'Playfair Display',serif;font-size:19px;color:var(--gold);margin-bottom:16px;padding-bottom:10px;border-bottom:1px solid var(--gold-border);display:flex;align-items:center;gap:10px;}
.dash-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-bottom:28px;}
.stat-card{background:var(--dark2);border:1px solid var(--gold-border);border-radius:var(--radius2);padding:22px;position:relative;overflow:hidden;transition:var(--trans);}
.stat-card:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 8px 30px rgba(201,168,76,0.15);}
.stat-card::before{content:'';position:absolute;top:0;right:0;width:70px;height:70px;border-radius:0 var(--radius2) 0 70px;background:var(--gold-bg);}
.stat-icon{font-size:26px;margin-bottom:10px;}.stat-label{font-size:11px;font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);}
.stat-value{font-family:'Playfair Display',serif;font-size:26px;color:var(--gold2);margin:4px 0;}.stat-sub{font-size:13px;color:var(--text3);}
.menu-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;}
.menu-card{background:var(--dark2);border:1px solid var(--gold-border);border-radius:var(--radius2);padding:24px 18px;cursor:pointer;transition:var(--trans);display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;}
.menu-card:hover{border-color:var(--gold);background:var(--gold-bg);transform:translateY(-3px);box-shadow:0 10px 32px rgba(201,168,76,0.2);}
.menu-icon{font-size:34px;}.menu-label{font-family:'Playfair Display',serif;font-size:16px;color:var(--gold2);}.menu-desc{font-size:13px;color:var(--text3);}
.alert-item{display:flex;align-items:flex-start;gap:14px;padding:14px 18px;border-radius:var(--radius);margin-bottom:10px;border-left:3px solid;}
.alert-item.warning{background:rgba(201,168,76,.08);border-color:var(--gold);}
.alert-item.danger{background:rgba(192,57,43,.08);border-color:var(--red2);}
.alert-item.info{background:rgba(41,128,185,.08);border-color:var(--blue2);}
.alert-item.success{background:rgba(39,174,96,.08);border-color:var(--green2);}
.alert-icon{font-size:20px;flex-shrink:0;}.alert-title{font-weight:600;font-size:15px;color:var(--text);}.alert-desc{font-size:13px;color:var(--text3);margin-top:3px;}
.modal-ov{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.87);backdrop-filter:blur(4px);display:none;justify-content:center;align-items:center;padding:16px;}
.modal-ov.open{display:flex;}
.modal{background:var(--dark2);border:1px solid var(--gold-border);border-radius:var(--radius2);padding:30px;width:100%;max-width:580px;max-height:92vh;overflow-y:auto;box-shadow:0 24px 80px rgba(0,0,0,.9);animation:mIn .25s cubic-bezier(.34,1.56,.64,1);}
@keyframes mIn{from{transform:scale(.9) translateY(20px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
.mhdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid var(--gold-border);}
.mtitle{font-family:'Playfair Display',serif;font-size:21px;color:var(--gold2);}
.mclose{background:none;border:none;color:var(--text3);font-size:22px;cursor:pointer;transition:var(--trans);padding:4px;}
.mclose:hover{color:var(--red2);}
.mfoot{display:flex;gap:12px;justify-content:flex-end;margin-top:22px;padding-top:14px;border-top:1px solid var(--gold-border);}
.badge{display:inline-block;padding:3px 10px;border-radius:12px;font-family:'JetBrains Mono',monospace;font-size:12px;}
.badge.inc{background:rgba(39,174,96,.15);color:var(--green2);border:1px solid rgba(39,174,96,.3);}
.badge.exp{background:rgba(192,57,43,.15);color:var(--red2);border:1px solid rgba(192,57,43,.3);}
.badge.gld{background:var(--gold-bg);color:var(--gold2);border:1px solid var(--gold-border);}
.badge.ovd{background:rgba(192,57,43,.2);color:#ff6b5b;border:1px solid rgba(192,57,43,.4);}
.badge.due{background:rgba(201,168,76,.15);color:var(--gold2);border:1px solid var(--gold-border);}
.badge.paid{background:rgba(39,174,96,.15);color:var(--green2);border:1px solid rgba(39,174,96,.3);}
.filter-row{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-bottom:20px;padding:18px;background:var(--dark2);border:1px solid var(--gold-border);border-radius:var(--radius);}
.filter-row .form-group{flex:1;min-width:130px;}
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px;}
.chart-box{background:var(--dark2);border:1px solid var(--gold-border);border-radius:var(--radius2);padding:20px;}
.chart-box h3{font-family:'Playfair Display',serif;font-size:17px;color:var(--gold);margin-bottom:16px;}
@media(max-width:700px){.chart-grid{grid-template-columns:1fr;}}
.budget-item{margin-bottom:18px;}.budget-hdr{display:flex;justify-content:space-between;margin-bottom:6px;font-size:14px;}
.bbar-wrap{height:8px;background:var(--dark4);border-radius:4px;overflow:hidden;}
.bbar{height:100%;border-radius:4px;transition:width .8s ease;}
.bbar.safe{background:linear-gradient(90deg,var(--green2),#58D68D);}
.bbar.warn{background:linear-gradient(90deg,var(--gold),var(--gold2));}
.bbar.dngr{background:linear-gradient(90deg,var(--red),var(--red2));}
.tag-wrap{display:flex;flex-wrap:wrap;gap:6px;padding:8px;background:var(--dark3);border:1px solid var(--gold-border);border-radius:var(--radius);min-height:44px;cursor:text;}
.tag{display:inline-flex;align-items:center;gap:6px;background:var(--gold-bg);border:1px solid var(--gold-border);color:var(--gold2);padding:3px 10px;border-radius:12px;font-size:14px;}
.tag .rm{cursor:pointer;color:var(--text3);font-size:16px;line-height:1;}.tag .rm:hover{color:var(--red2);}
.tag-inp{background:none;border:none;outline:none;color:var(--text);font-family:'Cormorant Garamond',serif;font-size:16px;min-width:120px;flex:1;}
.empty{text-align:center;padding:48px 20px;color:var(--text3);font-size:16px;}
.empty-ico{font-size:48px;margin-bottom:12px;opacity:.4;}
.fs-table{width:100%;border-collapse:collapse;font-size:15px;margin-bottom:8px;}
.fs-table th{padding:10px 14px;text-align:left;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--gold);border-bottom:1px solid var(--gold-border);background:var(--dark4);}
.fs-table td{padding:10px 14px;border-bottom:1px solid rgba(201,168,76,.06);}
.fs-table tr.total-row td{font-weight:700;color:var(--gold2);border-top:2px solid var(--gold-border);background:var(--dark4);font-family:'JetBrains Mono',monospace;}
.fs-table tr.sub-hdr td{color:var(--text2);font-style:italic;background:var(--dark3);padding:6px 14px;font-size:14px;}
.receipt-thumb{width:48px;height:36px;object-fit:cover;border-radius:4px;border:1px solid var(--gold-border);cursor:pointer;}
.upload-area{border:2px dashed var(--gold-border);border-radius:var(--radius);padding:20px;text-align:center;cursor:pointer;transition:var(--trans);color:var(--text3);}
.upload-area:hover{border-color:var(--gold);background:var(--gold-bg);color:var(--text2);}
@media(max-width:500px){.top-nav{padding:0 14px;}.cw{padding:18px 14px;}.ptitle{font-size:22px;}.nav-clock .dt{display:none;}}

/* P&L / FS specific */
.fs-section{margin-bottom:28px;}
.fs-section-title{font-family:'Playfair Display',serif;font-size:18px;color:var(--gold);padding:10px 14px;background:var(--dark3);border-left:3px solid var(--gold);border-radius:0 var(--radius) var(--radius) 0;margin-bottom:12px;}
.reconcile-match{color:var(--green2);font-weight:700;}
.reconcile-diff{color:var(--red2);font-weight:700;}

/* Alert Bell */
.alert-bell-wrap{position:relative;display:flex;align-items:center;}
.alert-bell-btn{background:none;border:1px solid var(--gold-border);border-radius:var(--radius);padding:6px 10px;cursor:pointer;font-size:18px;color:var(--text2);transition:var(--trans);display:flex;align-items:center;gap:6px;position:relative;}
.alert-bell-btn:hover{border-color:var(--gold);color:var(--gold);background:var(--gold-bg);}
.alert-badge{position:absolute;top:-6px;right:-6px;background:var(--red2);color:#fff;border-radius:50%;width:18px;height:18px;font-size:10px;font-family:'JetBrains Mono',monospace;display:flex;align-items:center;justify-content:center;font-weight:700;border:2px solid var(--dark);}
.alert-badge.hidden{display:none;}
.alert-dropdown{position:absolute;top:calc(100% + 10px);right:0;width:340px;max-height:380px;overflow-y:auto;background:var(--dark2);border:1px solid var(--gold-border);border-radius:var(--radius2);box-shadow:0 16px 60px rgba(0,0,0,.9);z-index:9000;display:none;}
.alert-dropdown.open{display:block;animation:mIn .2s ease;}
.alert-drop-hdr{padding:12px 16px;border-bottom:1px solid var(--gold-border);font-family:'Playfair Display',serif;font-size:15px;color:var(--gold);display:flex;justify-content:space-between;align-items:center;}
.alert-drop-body{padding:10px 12px;display:flex;flex-direction:column;gap:8px;}
.alert-drop-item{display:flex;align-items:flex-start;gap:10px;padding:10px 12px;border-radius:var(--radius);border-left:3px solid;}
.alert-drop-item.danger{background:rgba(192,57,43,.08);border-color:var(--red2);}
.alert-drop-item.warning{background:rgba(201,168,76,.08);border-color:var(--gold);}
.alert-drop-item.info{background:rgba(41,128,185,.08);border-color:var(--blue2);}
.alert-drop-item.success{background:rgba(39,174,96,.08);border-color:var(--green2);}
.alert-drop-title{font-size:13px;font-weight:600;color:var(--text);}
.alert-drop-desc{font-size:12px;color:var(--text3);margin-top:2px;}
</style>
</head>
<body>
<div class="bg-grid"></div>
<div class="bg-glow tr"></div>
<div class="bg-glow bl"></div>
<div id="toast-wrap"></div>

<!-- ═══ MODALS ═══════════════════════════════════════ -->

<!-- PDF Modal -->
<div class="modal-ov" id="m-pdf">
  <div class="modal" style="max-width:460px">
    <div class="mhdr"><span class="mtitle">📄 Download PDF</span><button class="mclose" onclick="cm('m-pdf')">✕</button></div>
    <div class="form-group" style="margin-bottom:14px">
      <label>Remarks / Notes</label>
      <textarea class="form-control" id="pdf-remarks" rows="3" placeholder="Optional remarks to include…"></textarea>
    </div>
    <div class="form-group">
      <label>Include in PDF</label>
      <div style="display:flex;gap:16px;margin-top:8px;flex-wrap:wrap">
        <label style="display:flex;align-items:center;gap:6px;font-size:15px;cursor:pointer;color:var(--text)"><input type="checkbox" id="pi-stamp" checked style="accent-color:var(--gold)"> Stamp</label>
        <label style="display:flex;align-items:center;gap:6px;font-size:15px;cursor:pointer;color:var(--text)"><input type="checkbox" id="pi-sig" checked style="accent-color:var(--gold)"> Signature</label>
        <label style="display:flex;align-items:center;gap:6px;font-size:15px;cursor:pointer;color:var(--text)"><input type="checkbox" id="pi-logo" checked style="accent-color:var(--gold)"> Logo</label>
      </div>
    </div>
    <div class="mfoot"><button class="btn" onclick="cm('m-pdf')">Cancel</button><button class="btn primary" onclick="execPdf()">⬇ Download</button></div>
  </div>
</div>

<!-- Account Types Modal -->
<div class="modal-ov" id="m-actype">
  <div class="modal" style="max-width:460px">
    <div class="mhdr"><span class="mtitle">⚙ Account Types</span><button class="mclose" onclick="cm('m-actype')">✕</button></div>
    <p style="font-size:14px;color:var(--text3);margin-bottom:14px">Press Enter to add. Click ✕ to remove.</p>
    <div class="tag-wrap" id="actype-tags" onclick="document.getElementById('actype-inp').focus()">
      <input class="tag-inp" id="actype-inp" placeholder="Type and press Enter…"/>
    </div>
    <div class="mfoot"><button class="btn primary" onclick="cm('m-actype')">Done</button></div>
  </div>
</div>

<!-- Budget Modal -->
<div class="modal-ov" id="m-budget">
  <div class="modal" style="max-width:440px">
    <div class="mhdr"><span class="mtitle">🎯 Set Budget</span><button class="mclose" onclick="cm('m-budget')">✕</button></div>
    <div class="fg c2">
      <div class="form-group"><label>Category</label><input class="form-control" id="b-cat" placeholder="e.g. Food"/></div>
      <div class="form-group"><label>Monthly Limit (Rs.)</label><input class="form-control" type="number" id="b-limit" placeholder="5000"/></div>
    </div>
    <div class="mfoot"><button class="btn" onclick="cm('m-budget')">Cancel</button><button class="btn primary" onclick="saveBudget()">Save</button></div>
  </div>
</div>

<!-- Edit Txn Modal -->
<div class="modal-ov" id="m-edit-txn">
  <div class="modal">
    <div class="mhdr"><span class="mtitle">✏ Edit Transaction</span><button class="mclose" onclick="cm('m-edit-txn')">✕</button></div>
    <div id="edit-txn-body"></div>
    <div class="mfoot"><button class="btn" onclick="cm('m-edit-txn')">Cancel</button><button class="btn primary" onclick="saveEditTxn()">Save Changes</button></div>
  </div>
</div>

<!-- Journal Modal -->
<div class="modal-ov" id="m-journal">
  <div class="modal" style="max-width:680px">
    <div class="mhdr"><span class="mtitle">📖 New Journal Entry</span><button class="mclose" onclick="cm('m-journal')">✕</button></div>
    <div class="fg c2" style="margin-bottom:16px">
      <div class="form-group"><label>Date</label><input class="form-control" type="date" id="je-date"/></div>
      <div class="form-group"><label>Description</label><input class="form-control" id="je-desc" placeholder="Narration"/></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 110px 110px 36px;gap:6px;margin-bottom:6px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text3);text-transform:uppercase;letter-spacing:.06em">
