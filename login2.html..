window.openJM=()=>{ document.getElementById('je-date').value=today(); document.getElementById('je-desc').value=''; document.getElementById('je-lines').innerHTML=''; addJeLine(); addJeLine(); om('m-journal'); };
window.addJeLine=()=>{
  const d=document.createElement('div'); d.style.cssText='display:grid;grid-template-columns:1fr 1fr 110px 110px 36px;gap:6px;margin-bottom:6px';
  d.innerHTML=`<input class="form-control je-acc" placeholder="Account" oninput="calcJe()"/><input class="form-control je-nar" placeholder="Narration"/><input class="form-control je-dr" type="number" placeholder="0.00" oninput="calcJe()"/><input class="form-control je-cr" type="number" placeholder="0.00" oninput="calcJe()"/><button class="btn sm danger" onclick="this.parentElement.remove();calcJe()">✕</button>`;
  document.getElementById('je-lines').appendChild(d);
};
window.calcJe=()=>{ let dr=0,cr=0; document.querySelectorAll('.je-dr').forEach(e=>dr+=parseFloat(e.value)||0); document.querySelectorAll('.je-cr').forEach(e=>cr+=parseFloat(e.value)||0); document.getElementById('je-tdr').textContent=dr.toFixed(2); document.getElementById('je-tcr').textContent=cr.toFixed(2); };
window.saveJournal=async()=>{
  const date=document.getElementById('je-date').value;
  const desc=document.getElementById('je-desc').value.trim();
  const lines=[]; let tdr=0,tcr=0;
  document.querySelectorAll('#je-lines > div').forEach(row=>{
    const acc=row.querySelector('.je-acc').value.trim();
    const nar=row.querySelector('.je-nar').value.trim();
    const dr=parseFloat(row.querySelector('.je-dr').value)||0;
    const cr=parseFloat(row.querySelector('.je-cr').value)||0;
    if(acc){ lines.push({acc,nar,dr,cr}); tdr+=dr; tcr+=cr; }
  });
  if(!lines.length){ toast('Add at least one line','error'); return; }
  if(Math.abs(tdr-tcr)>0.01){ toast('Debit and Credit must balance','error'); return; }
  try{
    await push(ref(db,`u/${uid()}/jnl`),{date,desc,lines,tdr,tcr,ts:Date.now()});
    toast('Journal entry saved ✓','success'); cm('m-journal');
  }catch(e){ toast('Save failed: '+e.message,'error'); console.error(e); }
};
window.renderJournal=()=>{
  const rows=Object.entries(JNL).map(([k,v])=>({...v,key:k})).sort((a,b)=>b.date.localeCompare(a.date));
  const tbody=document.getElementById('jnl-body'), tfoot=document.getElementById('jnl-foot');
  if(!rows.length){ tbody.innerHTML=`<tr><td colspan="7"><div class="empty"><div class="empty-ico">📖</div>No entries yet</div></td></tr>`; tfoot.innerHTML=''; return; }
  let td=0,tc=0;
  tbody.innerHTML=rows.map((r,i)=>{ td+=r.tdr; tc+=r.tcr;
    const lines=r.lines.map(l=>`<span style="font-size:12px;color:var(--text2)">${l.acc}: Dr ${l.dr.toFixed(2)} / Cr ${l.cr.toFixed(2)}</span>`).join(' | ');
    return `<tr><td style="color:var(--text3)">${i+1}</td><td>${fmtDate(r.date)}</td><td><strong>${r.desc}</strong></td><td style="font-size:12px">${lines}</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--green2)">${fmtAmt(r.tdr)}</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--red2)">${fmtAmt(r.tcr)}</td><td><button class="btn sm danger" onclick="delJnl('${r.key}')">🗑</button></td></tr>`;
  }).join('');
  tfoot.innerHTML=`<tr><td colspan="4" style="text-align:right">TOTAL</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--green2)">${fmtAmt(td)}</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--red2)">${fmtAmt(tc)}</td><td></td></tr>`;
};
