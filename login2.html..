window.renderReports=()=>{
  const now=new Date(),m=now.getMonth(),y=now.getFullYear();
  let tInc=0,tExp=0,mInc=0,mExp=0;
  const eByAcc={},pCount={};
  const txArr=Object.values(TXN);
  txArr.forEach(t=>{
    if(t.type==='Income') tInc+=t.amount;
    if(t.type==='Expense'){ tExp+=t.amount; eByAcc[t.acname]=(eByAcc[t.acname]||0)+t.amount; }
    pCount[t.payment]=(pCount[t.payment]||0)+1;
    const d=new Date(t.date);
    if(d.getMonth()===m&&d.getFullYear()===y){ if(t.type==='Income') mInc+=t.amount; if(t.type==='Expense') mExp+=t.amount; }
  });
  const net=tInc-tExp;
  document.getElementById('rep-stats').innerHTML=`
    <div class="stat-card"><div class="stat-icon">💰</div><div class="stat-label">Total Income</div><div class="stat-value" style="color:var(--green2)">${fmtAmt(tInc)}</div></div>
    <div class="stat-card"><div class="stat-icon">💸</div><div class="stat-label">Total Expenses</div><div class="stat-value" style="color:var(--red2)">${fmtAmt(tExp)}</div></div>
    <div class="stat-card"><div class="stat-icon">📊</div><div class="stat-label">Net Balance</div><div class="stat-value" style="color:${net>=0?'var(--gold2)':'var(--red2)'}">${fmtAmt(net)}</div></div>
    <div class="stat-card"><div class="stat-icon">📅</div><div class="stat-label">This Month Net</div><div class="stat-value" style="color:${(mInc-mExp)>=0?'var(--green2)':'var(--red2)'}">${fmtAmt(mInc-mExp)}</div></div>`;
  const mons=[],incA=[],expA=[];
  for(let i=5;i>=0;i--){ const d=new Date(y,m-i,1); const mm=d.getMonth(),yy=d.getFullYear(); mons.push(d.toLocaleString('default',{month:'short'})); let ii=0,ee=0; txArr.forEach(t=>{ const td=new Date(t.date); if(td.getMonth()===mm&&td.getFullYear()===yy){ if(t.type==='Income') ii+=t.amount; if(t.type==='Expense') ee+=t.amount; } }); incA.push(ii); expA.push(ee); }
