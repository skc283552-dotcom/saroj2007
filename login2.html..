window.renderDash=()=>{
  const now=new Date(), m=now.getMonth(), y=now.getFullYear();
  let tInc=0,tExp=0,mInc=0,mExp=0;
  const txArr=Object.values(TXN);
  txArr.forEach(t=>{
    if(t.type==='Income') tInc+=t.amount; if(t.type==='Expense') tExp+=t.amount;
    const d=new Date(t.date);
    if(d.getMonth()===m&&d.getFullYear()===y){ if(t.type==='Income') mInc+=t.amount; if(t.type==='Expense') mExp+=t.amount; }
  });
  const net=tInc-tExp;
  const totDebtors=Object.values(DEBTORS).reduce((s,r)=>s+(r.status!=='paid'?r.amount:0),0);
  const totCreditors=Object.values(CREDITORS).reduce((s,r)=>s+(r.status!=='paid'?r.amount:0),0);
  document.getElementById('dash-stats').innerHTML=`
    <div class="stat-card"><div class="stat-icon">💰</div><div class="stat-label">Net Balance</div><div class="stat-value" style="color:${net>=0?'var(--gold2)':'var(--red2)'}">${fmtAmt(net)}</div><div class="stat-sub">All time</div></div>
    <div class="stat-card"><div class="stat-icon">📈</div><div class="stat-label">This Month Income</div><div class="stat-value" style="color:var(--green2)">${fmtAmt(mInc)}</div><div class="stat-sub">${now.toLocaleString('default',{month:'long'})}</div></div>
    <div class="stat-card"><div class="stat-icon">📉</div><div class="stat-label">This Month Expenses</div><div class="stat-value" style="color:var(--red2)">${fmtAmt(mExp)}</div><div class="stat-sub">${now.toLocaleString('default',{month:'long'})}</div></div>
    <div class="stat-card"><div class="stat-icon">🤝</div><div class="stat-label">Receivable</div><div class="stat-value" style="color:var(--green2)">${fmtAmt(totDebtors)}</div><div class="stat-sub">Debtors pending</div></div>
    <div class="stat-card"><div class="stat-icon">💸</div><div class="stat-label">Payable</div><div class="stat-value" style="color:var(--red2)">${fmtAmt(totCreditors)}</div><div class="stat-sub">Creditors pending</div></div>
    <div class="stat-card"><div class="stat-icon">📋</div><div class="stat-label">Transactions</div><div class="stat-value">${txArr.length}</div><div class="stat-sub">Total entries</div></div>`;

  // Alerts — also update bell
  const today_str=today();
  const alerts=[];
  if(mExp>mInc&&mInc>0) alerts.push({t:'danger',i:'⚠',title:'Expenses exceed income this month!',desc:`Overspending by ${fmtAmt(mExp-mInc)}`});
  Object.values(DEBTORS).forEach(d=>{ if(d.status!=='paid'&&d.due&&d.due<today_str) alerts.push({t:'danger',i:'⏰',title:`Debtor overdue: ${d.name}`,desc:`Rs.${d.amount} was due on ${fmtDate(d.due)}`}); });
  Object.values(CREDITORS).forEach(d=>{ if(d.status!=='paid'&&d.due&&d.due<today_str) alerts.push({t:'warning',i:'⏰',title:`Payment due: ${d.name}`,desc:`You owe Rs.${d.amount} — was due ${fmtDate(d.due)}`}); });
  Object.values(BUDGETS).forEach(b=>{ const spent=txArr.filter(t=>t.type==='Expense'&&t.acname.toLowerCase().includes(b.cat.toLowerCase())&&new Date(t.date).getMonth()===m).reduce((s,t)=>s+t.amount,0); if(spent>=b.limit) alerts.push({t:'danger',i:'🎯',title:`Budget exceeded: ${b.cat}`,desc:`${fmtAmt(spent)} of ${fmtAmt(b.limit)} limit`}); });
  if(txArr.length===0) alerts.push({t:'info',i:'💡',title:'No transactions yet',desc:'Add your first transaction to get started.'});
  document.getElementById('dash-alerts').innerHTML=alerts.length?`<div style="margin-bottom:24px"><div class="sec-title">🔔 Alerts (${alerts.length})</div>${alerts.map(a=>`<div class="alert-item ${a.t}"><span class="alert-icon">${a.i}</span><div><div class="alert-title">${a.title}</div><div class="alert-desc">${a.desc}</div></div></div>`).join('')}</div>`:'';
  // Update bell badge
  const badge=document.getElementById('alert-badge-count');
  const dropCount=document.getElementById('alert-drop-count');
  const dropBody=document.getElementById('alert-drop-body');
  const realAlerts=alerts.filter(a=>a.t!=='info'||txArr.length===0);
  if(badge){ if(realAlerts.length>0){ badge.textContent=realAlerts.length; badge.classList.remove('hidden'); } else { badge.classList.add('hidden'); } }
  if(dropCount) dropCount.textContent=realAlerts.length+' alert'+(realAlerts.length!==1?'s':'');
  if(dropBody) dropBody.innerHTML=realAlerts.length?realAlerts.map(a=>`<div class="alert-drop-item ${a.t}"><span style="font-size:16px">${a.i}</span><div><div class="alert-drop-title">${a.title}</div><div class="alert-drop-desc">${a.desc}</div></div></div>`).join(''):`<div style="padding:16px;text-align:center;color:var(--text3);font-size:14px">✅ No active alerts</div>`;
  renderDashCharts(m,y);
};

function renderDashCharts(m,y){
  const md={Income:0,Expense:0};
  Object.values(TXN).forEach(t=>{ const d=new Date(t.date); if(d.getMonth()===m&&d.getFullYear()===y){ if(t.type==='Income') md.Income+=t.amount; if(t.type==='Expense') md.Expense+=t.amount; } });
  buildChart('dc-month','bar',['Income','Expense'],[md.Income,md.Expense],['#27AE60','#C0392B']);
  const mons=[],inc=[],exp=[];
  for(let i=5;i>=0;i--){ const d=new Date(y,m-i,1); const mm=d.getMonth(),yy=d.getFullYear(); mons.push(d.toLocaleString('default',{month:'short'})); let ii=0,ee=0; Object.values(TXN).forEach(t=>{ const td=new Date(t.date); if(td.getMonth()===mm&&td.getFullYear()===yy){ if(t.type==='Income') ii+=t.amount; if(t.type==='Expense') ee+=t.amount; } }); inc.push(ii); exp.push(ee); }
  buildChart('dc-trend','line',mons,[inc,exp],['#27AE60','#C0392B'],true);
}

