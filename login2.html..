async function loadB64(src){
  return new Promise(res=>{ const img=new Image(); img.crossOrigin='anonymous'; img.onload=()=>{ const c=document.createElement('canvas'); c.width=img.width; c.height=img.height; c.getContext('2d').drawImage(img,0,0); res(c.toDataURL('image/jpeg')); }; img.onerror=()=>res(null); img.src=src+'?t='+Date.now(); });
}

async function genPDF(type,remarks,useStamp,useSig,useLogo){
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF({orientation:'portrait',unit:'mm',format:'a4'});
  const W=210,H=297,now=new Date();
  // Header
  doc.setFillColor(10,10,10); doc.rect(0,0,W,40,'F');
  doc.setDrawColor(201,168,76); doc.setLineWidth(0.5); doc.line(0,40,W,40);
  if(useLogo){ const lb=await loadB64('logo1.jpg'); if(lb) doc.addImage(lb,'JPEG',10,6,28,28); }
  doc.setTextColor(201,168,76); doc.setFont('helvetica','bold'); doc.setFontSize(15); doc.text(BUSI.name,42,17);
  doc.setFont('helvetica','normal'); doc.setFontSize(9); doc.setTextColor(180,160,110);
  doc.text(`${BUSI.address}  |  Ph: ${BUSI.phone}  |  ${BUSI.email}`,42,24);
  doc.text(`${BUSI.website}  |  ${now.toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'})}  |  ${now.toLocaleTimeString()}`,42,30);
  // Title
  const titles={ledger:'GENERAL LEDGER',journal:'JOURNAL ENTRIES',report:'FINANCIAL REPORT',goods:'PURCHASE REGISTER',pl:'PROFIT & LOSS STATEMENT',tb:'TRIAL BALANCE',cf:'CASH FLOW SUMMARY',dc:'DEBTORS & CREDITORS REPORT',reconcile:'BANK RECONCILIATION'};
  doc.setFillColor(25,18,5); doc.rect(0,43,W,11,'F');
  doc.setTextColor(232,201,106); doc.setFont('helvetica','bold'); doc.setFontSize(12);
  doc.text(titles[type]||'REPORT',W/2,51,{align:'center'});
  let y=62;
  if(remarks){ doc.setFillColor(28,24,10); doc.rect(10,y,W-20,10,'F'); doc.setTextColor(200,180,100); doc.setFont('helvetica','italic'); doc.setFontSize(10); doc.text('Remarks: '+remarks,14,y+7); y+=14; }

  const hstyle={fillColor:[25,18,5],textColor:[201,168,76],fontStyle:'bold',fontSize:9};
  const fstyle={fillColor:[25,18,5],textColor:[232,201,106],fontStyle:'bold'};
  const opts={theme:'grid',headStyles:hstyle,footStyles:fstyle,alternateRowStyles:{fillColor:[248,244,235]},styles:{fontSize:9,cellPadding:3},margin:{left:10,right:10}};

  if(type==='ledger'){
    const rows=Object.values(TXN).sort((a,b)=>b.date.localeCompare(a.date));
    let inc=0,exp=0; rows.forEach(r=>{ if(r.type==='Income') inc+=r.amount; if(r.type==='Expense') exp+=r.amount; });
    doc.autoTable({startY:y,...opts,head:[['#','Date','Account','Type','Payment','Description','Amount (Rs.)']],body:rows.map((r,i)=>[i+1,fmtDate(r.date),r.acname,r.type,r.payment,r.desc||'—',r.amount.toFixed(2)]),foot:[['','','','','','INCOME',inc.toFixed(2)],['','','','','','EXPENSE',exp.toFixed(2)],['','','','','','NET',( inc-exp).toFixed(2)]]});
  } else if(type==='journal'){
    const rows=Object.values(JNL).sort((a,b)=>b.date.localeCompare(a.date)); let td=0,tc=0; rows.forEach(r=>{td+=r.tdr;tc+=r.tcr;});
    doc.autoTable({startY:y,...opts,head:[['#','Date','Description','Accounts','Debit','Credit']],body:rows.map((r,i)=>[i+1,fmtDate(r.date),r.desc,r.lines.map(l=>l.acc).join(', '),r.tdr.toFixed(2),r.tcr.toFixed(2)]),foot:[['','','','TOTAL',td.toFixed(2),tc.toFixed(2)]]});
  } else if(type==='goods'){
    const rows=Object.values(GOODS).sort((a,b)=>b.date.localeCompare(a.date)); let tot=0; rows.forEach(r=>tot+=r.total);
    doc.autoTable({startY:y,...opts,head:[['#','Date','Item','Qty','Unit Price','Total','Supplier','Payment']],body:rows.map((r,i)=>[i+1,fmtDate(r.date),r.item,r.qty,r.price.toFixed(2),r.total.toFixed(2),r.sup||'—',r.pay]),foot:[['','','','','TOTAL',tot.toFixed(2),'','']]});
  } else if(type==='pl'||type==='report'){
    const txArr=Object.values(TXN); let ti=0,te=0; const iAcc={},eAcc={};
    txArr.forEach(t=>{ if(t.type==='Income'){ iAcc[t.acname]=(iAcc[t.acname]||0)+t.amount; ti+=t.amount; } if(t.type==='Expense'){ eAcc[t.acname]=(eAcc[t.acname]||0)+t.amount; te+=t.amount; } });
    const net=ti-te;
    doc.autoTable({startY:y,...opts,head:[['Category','Account','Amount (Rs.)']],body:[...Object.entries(iAcc).map(([k,v])=>['Income',k,v.toFixed(2)]),...Object.entries(eAcc).map(([k,v])=>['Expense',k,v.toFixed(2)])],foot:[['TOTAL INCOME','',ti.toFixed(2)],['TOTAL EXPENSE','',te.toFixed(2)],[`NET ${net>=0?'PROFIT':'LOSS'}`,'',Math.abs(net).toFixed(2)]]});
  } else if(type==='tb'){
    const accs={}; Object.values(TXN).forEach(r=>{ if(!accs[r.acname]) accs[r.acname]={dr:0,cr:0}; if(r.type==='Income') accs[r.acname].cr+=r.amount; if(r.type==='Expense') accs[r.acname].dr+=r.amount; }); let td=0,tc=0; const rows=Object.entries(accs).map(([k,v])=>{ td+=v.dr;tc+=v.cr; return [k,v.dr.toFixed(2),v.cr.toFixed(2)]; });
    doc.autoTable({startY:y,...opts,head:[['Account','Debit (Rs.)','Credit (Rs.)']],body:rows,foot:[['TOTAL',td.toFixed(2),tc.toFixed(2)]]});
  } else if(type==='cf'){
    const txArr=Object.values(TXN); let ti=0,te=0; const byP={};
    txArr.forEach(t=>{ if(t.type==='Income'){ ti+=t.amount; byP[t.payment]=(byP[t.payment]||0)+t.amount; } if(t.type==='Expense'){ te+=t.amount; byP[t.payment]=(byP[t.payment]||0)-t.amount; } });
    doc.autoTable({startY:y,...opts,head:[['Description','Amount (Rs.)']],body:[['Total Income',ti.toFixed(2)],['Total Expenses',te.toFixed(2)],...Object.entries(byP).map(([k,v])=>[`Net Cash via ${k}`,v.toFixed(2)])],foot:[[`NET CASH ${(ti-te)>=0?'SURPLUS':'DEFICIT'}`,(ti-te).toFixed(2)]]});
  } else if(type==='dc'){
    const dRows=Object.values(DEBTORS); const cRows=Object.values(CREDITORS);
    let td=dRows.reduce((s,r)=>s+(r.status!=='paid'?r.amount:0),0);
    let tc=cRows.reduce((s,r)=>s+(r.status!=='paid'?r.amount:0),0);
    doc.setFontSize(11); doc.setTextColor(201,168,76); doc.text('DEBTORS (Receivable)',14,y); y+=4;
    doc.autoTable({startY:y,...opts,head:[['Name','Phone','Amount','Due Date','Status','Notes']],body:dRows.map(r=>[r.name,r.phone||'—',r.amount.toFixed(2),fmtDate(r.due)||'—',r.status,r.notes||'—']),foot:[['','TOTAL RECEIVABLE',td.toFixed(2),'','','']]});
    y=doc.lastAutoTable.finalY+10;
    doc.setFontSize(11); doc.setTextColor(201,168,76); doc.text('CREDITORS (Payable)',14,y); y+=4;
    doc.autoTable({startY:y,...opts,head:[['Name','Phone','Amount','Due Date','Status','Notes']],body:cRows.map(r=>[r.name,r.phone||'—',r.amount.toFixed(2),fmtDate(r.due)||'—',r.status,r.notes||'—']),foot:[['','TOTAL PAYABLE',tc.toFixed(2),'','','']]});
  } else if(type==='reconcile'){
    const bankArr=Object.values(BANK_ENTRIES); let bc=0,bd=0; bankArr.forEach(e=>{bc+=e.cr||0;bd+=e.dr||0;});
    const txArr=Object.values(TXN); let ti=0,te=0; txArr.forEach(t=>{ if(t.type==='Income') ti+=t.amount; if(t.type==='Expense') te+=t.amount; });
    doc.autoTable({startY:y,...opts,head:[['Item','Book (Rs.)','Bank (Rs.)']],body:[['Total Receipts/Income',ti.toFixed(2),bc.toFixed(2)],['Total Payments/Expenses',te.toFixed(2),bd.toFixed(2)],['Net Balance',(ti-te).toFixed(2),(bc-bd).toFixed(2)]],foot:[['DIFFERENCE',Math.abs((ti-te)-(bc-bd)).toFixed(2),'']]}); 
  }

  // Footer
  const fy=doc.lastAutoTable?doc.lastAutoTable.finalY+14:220;
  const footY=Math.min(fy,H-52);
  if(useSig){ const sb=await loadB64('signature1.jpg'); if(sb){ doc.addImage(sb,'JPEG',14,footY,46,20); } doc.setFontSize(8); doc.setTextColor(100,80,40); doc.line(14,footY+21,60,footY+21); doc.text('Authorized Signature',14,footY+25); }
  if(useStamp){ const stb=await loadB64('stamp1.jpg'); if(stb){ doc.addImage(stb,'JPEG',W-68,footY-4,40,32); } }
  doc.setDrawColor(201,168,76); doc.setLineWidth(0.3); doc.line(10,H-14,W-10,H-14);
  doc.setFontSize(8); doc.setTextColor(150,130,80);
  doc.text(`Generated by Saroj Personal Accounting  |  ${now.toLocaleString()}  |  ${BUSI.website}`,W/2,H-8,{align:'center'});
  const fname={ledger:'Ledger',journal:'Journal',report:'Report',goods:'Purchases',pl:'ProfitLoss',tb:'TrialBalance',cf:'CashFlow',dc:'DebtorsCreditors',reconcile:'BankReconciliation'};
  doc.save(`${fname[type]||'Report'}_${now.toISOString().split('T')[0]}.pdf`);
  toast('PDF downloaded ✓','success');
}

