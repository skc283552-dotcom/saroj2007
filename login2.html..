window.saveBudget=async()=>{
  const cat=document.getElementById('b-cat').value.trim();
  const limit=parseFloat(document.getElementById('b-limit').value);
  if(!cat||!limit){ toast('Category and limit required','error'); return; }
  try{
    await push(ref(db,`u/${uid()}/budgets`),{cat,limit,ts:Date.now()});
    toast('Budget saved ✓','success'); cm('m-budget');
  }catch(e){ toast('Save failed: '+e.message,'error'); console.error(e); }
};
window.renderBudget=()=>{
  const now=new Date(), m=now.getMonth(), y=now.getFullYear();
  const me={};
  Object.values(TXN).forEach(t=>{ if(t.type!=='Expense') return; const d=new Date(t.date); if(d.getMonth()===m&&d.getFullYear()===y){ me[t.acname]=(me[t.acname]||0)+t.amount; } });
  const rows=Object.entries(BUDGETS).map(([k,v])=>({...v,key:k}));
  const el=document.getElementById('budget-list');
  if(!rows.length){ el.innerHTML=`<div class="empty"><div class="empty-ico">🎯</div>No budgets set. Click "+ Set Budget".</div>`; return; }
  el.innerHTML=rows.map(b=>{
    const spent=Object.entries(me).reduce((s,[k,v])=>k.toLowerCase().includes(b.cat.toLowerCase())?s+v:s,0);
    const pct=Math.min((spent/b.limit)*100,100);
    const cls=pct>=90?'dngr':pct>=70?'warn':'safe';
    const color=cls==='safe'?'var(--green2)':cls==='warn'?'var(--gold)':'var(--red2)';
    return `<div class="budget-item"><div class="budget-hdr"><span style="color:var(--text)">${b.cat}</span><span style="font-family:'JetBrains Mono',monospace;font-size:13px"><span style="color:${color}">${fmtAmt(spent)}</span><span style="color:var(--text3)"> / ${fmtAmt(b.limit)}</span></span></div><div class="bbar-wrap"><div class="bbar ${cls}" style="width:${pct}%"></div></div><div style="display:flex;justify-content:space-between;margin-top:4px;font-size:12px;color:var(--text3)"><span>${pct.toFixed(1)}% used</span><button class="btn sm danger" style="padding:2px 8px;font-size:11px" onclick="delBudget('${b.key}')">Remove</button></div></div>`;
  }).join('');
};
