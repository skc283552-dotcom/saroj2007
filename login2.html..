  const pK=Object.keys(pCount);
  buildChart('rep-pie','pie',pK,pK.map(k=>pCount[k]),GPAL);
  const sugg=[];
  if(tExp>tInc) sugg.push({i:'⚠',m:'Total expenses exceed total income. Review spending.'});
