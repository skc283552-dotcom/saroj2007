  if(top) sugg.push({i:'📌',m:`Highest expense: <strong>${top[0]}</strong> — ${fmtAmt(top[1])}`});
  if(mExp>0.7*mInc&&mInc>0) sugg.push({i:'💡',m:'Spending over 70% of income this month.'});
