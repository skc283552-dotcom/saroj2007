window.renderDC=()=>{
  renderDCTable('debtor',DEBTORS,'debtor-body','debtor-foot','dc-debtor-stats');
  renderDCTable('creditor',CREDITORS,'creditor-body','creditor-foot','dc-creditor-stats');
};

function renderDCTable(mode,data,tbodyId,tfootId,statsId){
  const rows=Object.entries(data).map(([k,v])=>({...v,key:k})).sort((a,b)=>(a.due||'').localeCompare(b.due||''));
  const tbody=document.getElementById(tbodyId), tfoot=document.getElementById(tfootId), stats=document.getElementById(statsId);
  const table=mode==='debtor'?'debtors':'creditors';
  const now=today();
  let total=0,overdue=0,pending=0,paid=0;
  if(!rows.length){ tbody.innerHTML=`<tr><td colspan="8"><div class="empty"><div class="empty-ico">🤝</div>No ${mode}s yet</div></td></tr>`; tfoot.innerHTML=''; stats.innerHTML=''; return; }
  tbody.innerHTML=rows.map((r,i)=>{
    total+=r.amount;
    if(r.status==='paid') paid+=r.amount;
    else if(r.due&&r.due<now) overdue+=r.amount;
    else pending+=r.amount;
    const isOvd=r.status!=='paid'&&r.due&&r.due<now;
    const statusBadge=r.status==='paid'?'<span class="badge paid">Paid</span>':isOvd?'<span class="badge ovd">Overdue</span>':'<span class="badge due">Pending</span>';
    return `<tr><td style="color:var(--text3)">${i+1}</td><td><strong>${r.name}</strong></td><td style="font-family:'JetBrains Mono',monospace;font-size:13px">${r.phone||'—'}</td><td style="font-family:'JetBrains Mono',monospace;font-weight:600;color:${mode==='debtor'?'var(--green2)':'var(--red2)'}">${fmtAmt(r.amount)}</td><td style="color:${isOvd?'var(--red2)':'var(--text2)'}">${fmtDate(r.due)||'—'}</td><td>${statusBadge}</td><td style="color:var(--text3);font-size:13px">${r.notes||'—'}</td><td><div style="display:flex;gap:6px"><button class="btn sm" onclick="openDcModal('${mode}','${r.key}')">✏</button><button class="btn sm danger" onclick="delDC('${mode}','${r.key}')">🗑</button></div></td></tr>`;
  }).join('');
  tfoot.innerHTML=`<tr><td colspan="3" style="text-align:right">TOTAL</td><td style="font-family:'JetBrains Mono',monospace;color:${mode==='debtor'?'var(--green2)':'var(--red2)'};">${fmtAmt(total)}</td><td colspan="4"></td></tr>`;
  stats.innerHTML=`
    <div class="stat-card"><div class="stat-icon">${mode==='debtor'?'💰':'💸'}</div><div class="stat-label">Total ${mode==='debtor'?'Receivable':'Payable'}</div><div class="stat-value" style="color:${mode==='debtor'?'var(--green2)':'var(--red2)'}">${fmtAmt(total)}</div></div>
    <div class="stat-card"><div class="stat-icon">⏰</div><div class="stat-label">Overdue</div><div class="stat-value" style="color:var(--red2)">${fmtAmt(overdue)}</div></div>
    <div class="stat-card"><div class="stat-icon">🟡</div><div class="stat-label">Pending</div><div class="stat-value" style="color:var(--gold)">${fmtAmt(pending)}</div></div>
    <div class="stat-card"><div class="stat-icon">✅</div><div class="stat-label">Paid</div><div class="stat-value" style="color:var(--green2)">${fmtAmt(paid)}</div></div>`;
}
window.delDC=async(mode,key)=>{ const table=mode==='debtor'?'debtors':'creditors'; if(!confirm(`Delete this ${mode}?`)) return; await remove(ref(db,`u/${uid()}/${table}/${key}`)); toast('Deleted','success'); };

