  measurementId:"G-RW7Y1168FW"
};

const app     = initializeApp(firebaseConfig);
const auth    = getAuth(app);
const db      = getDatabase(app);
const storage = getStorage(app);

// ── STATE ────────────────────────────────────────────
let U = null;
let TXN={}, JNL={}, GOODS={}, BUDGETS={}, DEBTORS={}, CREDITORS={}, BANK_ENTRIES={};
let accountTypes = ['Assets','Liabilities','Equity','Income','Expenses','Capital'];
