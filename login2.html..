// P&L
window.renderPL=()=>{
  const from=document.getElementById('pl-from').value;
  const to=document.getElementById('pl-to').value;
  let rows=Object.values(TXN);
  if(from) rows=rows.filter(r=>r.date>=from);
  if(to)   rows=rows.filter(r=>r.date<=to);
  const incByAcc={}, expByAcc={};
  let totalInc=0, totalExp=0;
  rows.forEach(r=>{
    if(r.type==='Income'){ incByAcc[r.acname]=(incByAcc[r.acname]||0)+r.amount; totalInc+=r.amount; }
    if(r.type==='Expense'){ expByAcc[r.acname]=(expByAcc[r.acname]||0)+r.amount; totalExp+=r.amount; }
  });
  const net=totalInc-totalExp;
  const incRows=Object.entries(incByAcc).sort((a,b)=>b[1]-a[1]);
  const expRows=Object.entries(expByAcc).sort((a,b)=>b[1]-a[1]);
  document.getElementById('pl-output').innerHTML=`
    <div class="card" style="padding:0">
      <div style="padding:18px 20px;border-bottom:1px solid var(--gold-border);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:22px;color:var(--gold)">Profit & Loss Statement</div>
        <div style="font-size:13px;color:var(--text3);margin-top:4px">Period: ${fmtDate(from)} – ${fmtDate(to)}</div>
      </div>
      <table class="fs-table">
        <tr class="sub-hdr"><td colspan="2">INCOME</td></tr>
        ${incRows.map(([k,v])=>`<tr><td style="padding-left:28px;color:var(--text)">${k}</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--green2)">${fmtAmt(v)}</td></tr>`).join('')}
        <tr class="total-row"><td>TOTAL INCOME</td><td style="text-align:right;color:var(--green2)">${fmtAmt(totalInc)}</td></tr>
        <tr class="sub-hdr"><td colspan="2">EXPENSES</td></tr>
        ${expRows.map(([k,v])=>`<tr><td style="padding-left:28px;color:var(--text)">${k}</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--red2)">${fmtAmt(v)}</td></tr>`).join('')}
        <tr class="total-row"><td>TOTAL EXPENSES</td><td style="text-align:right;color:var(--red2)">${fmtAmt(totalExp)}</td></tr>
        <tr class="total-row" style="font-size:18px"><td>NET ${net>=0?'PROFIT':'LOSS'}</td><td style="text-align:right;color:${net>=0?'var(--gold2)':'var(--red2)'}">${fmtAmt(Math.abs(net))}</td></tr>
      </table>
    </div>`;
};

// TRIAL BALANCE
window.renderTB=()=>{
  const accs={};
  Object.values(TXN).forEach(r=>{
    if(!accs[r.acname]) accs[r.acname]={dr:0,cr:0};
    if(r.type==='Income') accs[r.acname].cr+=r.amount;
    if(r.type==='Expense') accs[r.acname].dr+=r.amount;
    if(r.type==='Transfer') accs[r.acname].dr+=r.amount;
  });
  Object.values(JNL).forEach(j=>j.lines.forEach(l=>{
    if(!accs[l.acc]) accs[l.acc]={dr:0,cr:0};
    accs[l.acc].dr+=l.dr; accs[l.acc].cr+=l.cr;
  }));
  let totalDr=0, totalCr=0;
  const rows=Object.entries(accs).map(([k,v])=>{ totalDr+=v.dr; totalCr+=v.cr; return [k,v.dr,v.cr]; });
  document.getElementById('tb-output').innerHTML=`
    <div class="card" style="padding:0">
      <div style="padding:18px 20px;border-bottom:1px solid var(--gold-border);text-align:center">
        <div style="font-family:'Playfair Display',serif;font-size:22px;color:var(--gold)">Trial Balance</div>
        <div style="font-size:13px;color:var(--text3);margin-top:4px">As of ${fmtDate(today())}</div>
      </div>
      <table class="fs-table">
        <thead><tr><th>Account</th><th style="text-align:right">Debit (Rs.)</th><th style="text-align:right">Credit (Rs.)</th></tr></thead>
        <tbody>${rows.map(([k,dr,cr])=>`<tr><td>${k}</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--green2)">${dr>0?dr.toFixed(2):'—'}</td><td style="text-align:right;font-family:'JetBrains Mono',monospace;color:var(--red2)">${cr>0?cr.toFixed(2):'—'}</td></tr>`).join('')}</tbody>
        <tfoot><tr class="total-row"><td>TOTAL</td><td style="text-align:right;color:var(--green2)">${fmtAmt(totalDr)}</td><td style="text-align:right;color:var(--red2)">${fmtAmt(totalCr)}</td></tr></tfoot>
      </table>
      <div style="padding:14px 20px;font-size:14px;color:${Math.abs(totalDr-totalCr)<0.01?'var(--green2)':'var(--red2)'}">
        ${Math.abs(totalDr-totalCr)<0.01?'✅ Trial Balance is BALANCED':'⚠ Difference: '+fmtAmt(Math.abs(totalDr-totalCr))}
      </div>
    </div>`;
};

// CASH FLOW
window.renderCF=()=>{
  const from=document.getElementById('cf-from').value;
  const to=document.getElementById('cf-to').value;
  let rows=Object.values(TXN);
  if(from) rows=rows.filter(r=>r.date>=from);
