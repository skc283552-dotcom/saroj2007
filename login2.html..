  document.getElementById('suggestions').innerHTML=sugg.map(s=>`<div class="alert-item info" style="margin-bottom:8px"><span class="alert-icon">${s.i}</span><div class="alert-title">${s.m}</div></div>`).join('');
};

// ── CHART BUILDER ─────────────────────────────────────
function buildChart(id,type,labels,data,colors,multi=false){
  const canvas=document.getElementById(id); if(!canvas) return;
  if(charts[id]) charts[id].destroy();
  Chart.defaults.color='#C4AA78'; Chart.defaults.borderColor='rgba(201,168,76,0.08)';
  let datasets;
  if(multi&&Array.isArray(data[0])){
    const names=type==='bar'?['Income','Expense']:['Net Balance'];
    datasets=data.map((d,i)=>({label:names[i]||'',data:d,backgroundColor:colors[i]+'44',borderColor:colors[i],borderWidth:2,fill:type==='line',tension:0.4,pointBackgroundColor:colors[i]}));
  } else { datasets=[{data,backgroundColor:colors,borderColor:colors.map(c=>c+'88'),borderWidth:2}]; }
  charts[id]=new Chart(canvas,{type,data:{labels,datasets},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{labels:{color:'#C4AA78',font:{family:"'Cormorant Garamond',serif",size:13}}},tooltip:{backgroundColor:'#1E1E1E',titleColor:'#C9A84C',bodyColor:'#EDE0C4',borderColor:'rgba(201,168,76,0.3)',borderWidth:1}},scales:['bar','line'].includes(type)?{x:{ticks:{color:'#7A6A48'},grid:{color:'rgba(201,168,76,0.05)'}},y:{ticks:{color:'#7A6A48'},grid:{color:'rgba(201,168,76,0.08)'}}}:{}}});
}

