// ── UTILITIES ─────────────────────────────────────────
window.nav = function(id){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
  const fns={
    'page-dashboard':renderDash,'page-ledger':renderLedger,'page-journal':renderJournal,
    'page-reports':renderReports,'page-budget':renderBudget,'page-goods':renderGoods,
    'page-dc':()=>{ showDcTab('debtors'); renderDC(); },
    'page-reconcile':renderReconcile,'page-fs':()=>showFsTab('pl'),
    'page-new-txn':initTxnForm
  };
  if(fns[id]) fns[id]();
};

function toast(msg,type='info'){
  const el=document.createElement('div'); el.className=`toast ${type}`; el.textContent=msg;
  document.getElementById('toast-wrap').appendChild(el);
  setTimeout(()=>el.remove(),3600);
}
window.om = id=>document.getElementById(id).classList.add('open');
window.cm = id=>document.getElementById(id).classList.remove('open');
window.omm= ()=>{}; // placeholder

const today=()=>new Date().toISOString().split('T')[0];
const fmtDate=d=>{ if(!d) return '—'; const dt=new Date(d); return isNaN(dt)?d:dt.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}); };
const fmtAmt=n=>'Rs. '+parseFloat(n||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2});
const uid=()=>U?.uid||'anon';

// ── CLOCK ─────────────────────────────────────────────
function tick(){
  const now=new Date();
  const t=now.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
  const d=now.toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});
  ['t-dash','t-acc','t-txn','t-led','t-jnl','t-rep','t-bud','t-gds','t-rec','t-dc','t-fs'].forEach(id=>{
    const e=document.getElementById(id); if(e) e.textContent=t;
  });
  const nd=document.getElementById('d-dash'); if(nd) nd.textContent=d;
}
setInterval(tick,1000); tick();

// ── AUTH ──────────────────────────────────────────────
let authMode='login';
window.toggleAuth=()=>{
  authMode=authMode==='login'?'register':'login';
  document.getElementById('auth-hd').textContent=authMode==='login'?'Sign In':'Create Account';
  document.getElementById('auth-btn').textContent=authMode==='login'?'Sign In':'Register';
  document.getElementById('auth-tog-txt').textContent=authMode==='login'?"Don't have an account?":"Already have an account?";
  document.getElementById('auth-tog-lnk').textContent=authMode==='login'?'Register':'Sign In';
  document.getElementById('a-name-g').classList.toggle('hidden',authMode==='login');
};

window.doAuth=async()=>{
  const email=document.getElementById('a-email').value.trim();
  const pass=document.getElementById('a-pass').value;
  if(!email||!pass){ toast('Enter email and password','error'); return; }
  try{
    if(authMode==='login') await signInWithEmailAndPassword(auth,email,pass);
    else await createUserWithEmailAndPassword(auth,email,pass);
  }catch(e){ toast(e.message,'error'); }
};

window.doSignOut=async()=>{ await signOut(auth); nav('page-login'); toast('Signed out'); };

onAuthStateChanged(auth,user=>{
  if(user){ U=user; document.getElementById('dash-welcome').textContent=`Welcome back, ${user.email}`; listenData(); nav('page-dashboard'); }
  else{ U=null; nav('page-login'); }
});

// ── FIREBASE LISTENERS ────────────────────────────────
function listenData(){
  const u=uid();
  onValue(ref(db,`u/${u}/txn`),s=>{ TXN=s.val()||{}; refreshActive(['page-ledger','page-dashboard','page-reports','page-reconcile']); });
  onValue(ref(db,`u/${u}/jnl`),s=>{ JNL=s.val()||{}; refreshActive(['page-journal']); });
  onValue(ref(db,`u/${u}/goods`),s=>{ GOODS=s.val()||{}; refreshActive(['page-goods']); });
  onValue(ref(db,`u/${u}/budgets`),s=>{ BUDGETS=s.val()||{}; refreshActive(['page-budget']); });
  onValue(ref(db,`u/${u}/debtors`),s=>{ DEBTORS=s.val()||{}; refreshActive(['page-dc']); });
  onValue(ref(db,`u/${u}/creditors`),s=>{ CREDITORS=s.val()||{}; refreshActive(['page-dc']); });
  onValue(ref(db,`u/${u}/bank`),s=>{ BANK_ENTRIES=s.val()||{}; refreshActive(['page-reconcile']); });
  onValue(ref(db,`u/${u}/accountTypes`),s=>{ if(s.val()) accountTypes=s.val(); refreshActypes(); renderActypeTags(); });
}
function refreshActive(pages){ pages.forEach(p=>{ if(document.getElementById(p)?.classList.contains('active')){ if(p==='page-ledger') renderLedger(); else if(p==='page-dashboard') renderDash(); else if(p==='page-reports') renderReports(); else if(p==='page-journal') renderJournal(); else if(p==='page-goods') renderGoods(); else if(p==='page-budget') renderBudget(); else if(p==='page-dc') renderDC(); else if(p==='page-reconcile') renderReconcile(); }}); }

// ── ACCOUNT TYPES ─────────────────────────────────────
function renderActypeTags(){
  const wrap=document.getElementById('actype-tags');
  const inp=document.getElementById('actype-inp');
  wrap.innerHTML='';
  accountTypes.forEach((t,i)=>{
    const tag=document.createElement('span'); tag.className='tag';
    tag.innerHTML=`${t} <span class="rm" data-i="${i}">✕</span>`;
    tag.querySelector('.rm').onclick=e=>{ accountTypes.splice(+e.target.dataset.i,1); set(ref(db,`u/${uid()}/accountTypes`),accountTypes); };
    wrap.appendChild(tag);
  });
  wrap.appendChild(inp);
}
document.getElementById('actype-inp').addEventListener('keydown',e=>{
  if(e.key==='Enter'){ const v=e.target.value.trim(); if(v&&!accountTypes.includes(v)){ accountTypes.push(v); set(ref(db,`u/${uid()}/accountTypes`),accountTypes); } e.target.value=''; }
});
function refreshActypes(){
  const dl=document.getElementById('actype-datalist'); if(!dl) return;
  dl.innerHTML=accountTypes.map(t=>`<option value="${t}">`).join('');
  // Also refresh account-name suggestions from past transactions
  const ndl=document.getElementById('acname-datalist'); if(!ndl) return;
  const names=[...new Set(Object.values(TXN).map(t=>t.acname).filter(Boolean))].sort();
  ndl.innerHTML=names.map(n=>`<option value="${n}">`).join('');
}

// ── RECEIPT UPLOAD ────────────────────────────────────
window.previewReceipt=function(inp){
  receiptFile=inp.files[0];
  if(!receiptFile) return;
  const reader=new FileReader();
  reader.onload=e=>{ document.getElementById('receipt-preview-wrap').innerHTML=`<img src="${e.target.result}" style="max-height:80px;border-radius:4px;margin-top:8px"/><br><small style="color:var(--green2)">✓ ${receiptFile.name}</small>`; };
  reader.readAsDataURL(receiptFile);
};

async function uploadReceipt(file){
  if(!file) return null;
  try{
    const path=`receipts/${uid()}/${Date.now()}_${file.name}`;
    const snap=await uploadBytes(sRef(storage,path),file);
    return await getDownloadURL(snap.ref);
  }catch(e){ toast('Receipt upload failed: '+e.message,'error'); return null; }
}

window.viewReceipt=function(url){
  document.getElementById('receipt-img').src=url;
  om('m-receipt');
};

// ── TRANSACTION FORM ──────────────────────────────────
window.initTxnForm=function(){
  refreshActypes();
  const auto=document.getElementById('txn-auto');
  const date=document.getElementById('txn-date');
  date.value=today(); date.disabled=true;
  auto.onchange=()=>{ date.disabled=auto.checked; if(auto.checked) date.value=today(); };
};
window.clearTxnForm=function(){
  ['txn-acname','txn-actype','txn-desc','txn-ref','txn-amt'].forEach(id=>{ const e=document.getElementById(id); if(e) e.value=''; });
  document.getElementById('txn-date').value=today();
  document.getElementById('txn-auto').checked=true;
  document.getElementById('txn-date').disabled=true;
  document.getElementById('receipt-preview-wrap').innerHTML='📷 Tap to upload receipt photo';
  document.getElementById('txn-receipt-inp').value='';
  receiptFile=null;
};
window.saveTxn=async function(){
  const acname=document.getElementById('txn-acname').value.trim();
  const actype=document.getElementById('txn-actype').value.trim();
  const type=document.getElementById('txn-type').value;
  const payment=document.getElementById('txn-pay').value;
  const amount=parseFloat(document.getElementById('txn-amt').value);
  const desc=document.getElementById('txn-desc').value.trim();
  const ref_no=document.getElementById('txn-ref').value.trim();
  const auto=document.getElementById('txn-auto').checked;
  const date=auto?today():document.getElementById('txn-date').value;
  if(!acname){ toast('Account name required','error'); return; }
  if(!amount||amount<=0){ toast('Enter valid amount','error'); return; }
  if(!actype){ toast('Account type required','error'); return; }
  toast('Saving…');
  try{
    const receiptUrl=await uploadReceipt(receiptFile);
    await push(ref(db,`u/${uid()}/txn`),{acname,actype,type,payment,amount,desc,ref_no,date,receiptUrl:receiptUrl||null,ts:Date.now()});
    // Auto-add actype to known types if new
    if(!accountTypes.includes(actype)){ accountTypes.push(actype); await set(ref(db,`u/${uid()}/accountTypes`),accountTypes); }
    toast('Transaction saved ✓','success');
    clearTxnForm();
  }catch(e){ toast('Save failed: '+e.message,'error'); console.error(e); }
};

// ── LEDGER ────────────────────────────────────────────
window.renderLedger=function(){
  const from=document.getElementById('lf-from')?.value;
  const to=document.getElementById('lf-to')?.value;
  const type=document.getElementById('lf-type')?.value;
  const pay=document.getElementById('lf-pay')?.value;
  const q=document.getElementById('lf-q')?.value.toLowerCase();
  let rows=Object.entries(TXN).map(([k,v])=>({...v,key:k}));
  if(from) rows=rows.filter(r=>r.date>=from);
  if(to)   rows=rows.filter(r=>r.date<=to);
  if(type) rows=rows.filter(r=>r.type===type);
  if(pay)  rows=rows.filter(r=>r.payment===pay);
  if(q)    rows=rows.filter(r=>(r.acname+r.desc+r.ref_no).toLowerCase().includes(q));
  rows.sort((a,b)=>b.date.localeCompare(a.date));
  const tbody=document.getElementById('led-body');
  const tfoot=document.getElementById('led-foot');
  if(!rows.length){ tbody.innerHTML=`<tr><td colspan="10"><div class="empty"><div class="empty-ico">📒</div>No transactions found</div></td></tr>`; tfoot.innerHTML=''; return; }
  let inc=0,exp=0;
  tbody.innerHTML=rows.map((r,i)=>{
    if(r.type==='Income') inc+=r.amount; if(r.type==='Expense') exp+=r.amount;
    const ac=r.type==='Income'?'var(--green2)':r.type==='Expense'?'var(--red2)':'var(--text)';
    const rcpt=r.receiptUrl?`<img src="${r.receiptUrl}" class="receipt-thumb" onclick="viewReceipt('${r.receiptUrl}')" title="View receipt"/>`: '—';
    return `<tr>
      <td style="color:var(--text3)">${i+1}</td>
      <td>${fmtDate(r.date)}</td>
      <td><strong>${r.acname}</strong><br><small style="color:var(--text3)">${r.actype}</small></td>
      <td><span class="badge ${r.type==='Income'?'inc':r.type==='Expense'?'exp':'gld'}">${r.type}</span></td>
      <td><span class="badge gld">${r.payment}</span></td>
      <td style="color:var(--text2)">${r.desc||'—'}</td>
      <td style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text3)">${r.ref_no||'—'}</td>
      <td>${rcpt}</td>
      <td style="text-align:right;font-family:'JetBrains Mono',monospace;color:${ac};font-weight:600">${fmtAmt(r.amount)}</td>
      <td><div style="display:flex;gap:6px"><button class="btn sm" onclick="openEditTxn('${r.key}')">✏</button><button class="btn sm danger" onclick="delTxn('${r.key}')">🗑</button></div></td>
    </tr>`;
  }).join('');
  const net=inc-exp;
  tfoot.innerHTML=`<tr><td colspan="8" style="text-align:right">TOTALS</td><td style="text-align:right;font-family:'JetBrains Mono',monospace"><span style="color:var(--green2)">+${fmtAmt(inc)}</span><br><span style="color:var(--red2)">-${fmtAmt(exp)}</span><br><span style="color:${net>=0?'var(--gold2)':'var(--red2)'}">Net: ${fmtAmt(net)}</span></td><td></td></tr>`;
};
window.clearLedger=()=>{ ['lf-from','lf-to','lf-q'].forEach(id=>document.getElementById(id).value=''); document.getElementById('lf-type').value=''; document.getElementById('lf-pay').value=''; renderLedger(); };
window.delTxn=async key=>{ if(!confirm('Delete this transaction?')) return; await remove(ref(db,`u/${uid()}/txn/${key}`)); toast('Deleted','success'); };
